      "groupRootRecordId": "kafka:github:issue:20970",
      "ordinal": 0,
      "title": "Expose broker readiness in the health endpoint",
      "text": "Operators need a cached readiness result so probes do not perform expensive metadata checks for every request. This issue is unrelated to producer batch accumulation.",
