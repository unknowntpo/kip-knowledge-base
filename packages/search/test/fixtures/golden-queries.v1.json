      "groupRootRecordId": "kafka:wiki:kip-405",
      "ordinal": 0,
      "title": "Bound the remote fetch thread pool per broker",
      "text": "The implementation caps concurrent remote log fetches per broker and records object-store latency so slow remote reads cannot exhaust request threads.",
      "canonicalUrl": "https://github.com/apache/kafka/pull/16511",
      "author": "Kafka contributor",
      "occurredAt": "2026-06-11T08:00:00Z",
