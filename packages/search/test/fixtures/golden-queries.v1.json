      "groupRootRecordId": "kafka:wiki:kip-405",
      "ordinal": 0,
      "title": "Re: [DISCUSS] KIP-405 compacted topic support",
      "text": "Tiered storage cannot yet be enabled on compacted topics. The cleaner assumes it can rewrite any segment in place, which is false after a segment has been uploaded to remote storage.",
      "canonicalUrl": "https://lists.apache.org/thread/kip-405-compaction-fixture",
      "author": "Kafka committer",
      "occurredAt": "2021-05-04T11:00:00Z",
