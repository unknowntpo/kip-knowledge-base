      "groupRootRecordId": "kafka:github:pr:23203",
      "ordinal": 0,
      "title": "KAFKA-20917: Reduce overhead in RecordAccumulator.ready()",
      "text": "RecordAccumulator.ready() loops once per topic and calls partitionReady for each partition on every Sender runOnce cycle. Cache the ready batches without changing producer delivery behavior.",
      "canonicalUrl": "https://github.com/apache/kafka/pull/23203",
      "author": "Kafka contributor",
      "occurredAt": "2026-08-25T03:20:00Z",
      "sourceVersion": "github-pr-23203-merged",
      "tags": ["producer", "performance", "record-accumulator"],
      "contentHash": "sha256:9a125c0fd468e8f193b416d301877838b31c431e7214afa9798160254231b05c"
    },
