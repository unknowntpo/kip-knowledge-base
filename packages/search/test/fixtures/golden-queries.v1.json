      "groupRootRecordId": "datafusion:github:issue:19877",
      "ordinal": 0,
      "title": "Optimizer loses relation qualifier after aggregate rewrite",
      "text": "A logical plan retains the qualified column before optimization, but the aggregate rewrite removes the relation qualifier and later projection cannot resolve the column.",
      "canonicalUrl": "https://github.com/apache/datafusion/issues/19877",
      "author": "DataFusion contributor",
      "occurredAt": "2026-07-01T10:00:00Z",
      "sourceVersion": "github-issue-19877-updated-2026-07-01",
      "tags": ["optimizer", "logical-plan", "aggregate"],
      "contentHash": "sha256:4e21e5779d3a56ded57efc16029d618aabfea921ea12e21fac39f1fb8912a765"
    },
