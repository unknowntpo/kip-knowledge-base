      "sourceInstanceId": "apache-datafusion-github",
      "recordId": "datafusion:github:comment:19877-1",
      "groupRootRecordId": "datafusion:github:issue:19877",
      "ordinal": 0,
      "title": "Issue 19877 maintainer analysis",
      "text": "The qualifier survives parsing and projection. It disappears specifically when Aggregate rewrites its output schema, so the fix belongs in the optimizer rule rather than the SQL parser.",
      "canonicalUrl": "https://github.com/apache/datafusion/issues/19877#issuecomment-1",
      "author": "DataFusion maintainer",
