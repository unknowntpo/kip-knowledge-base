      "ordinal": 0,
      "title": "KIP-405: Kafka Tiered Storage",
      "text": "Tiered storage moves older log segments from broker disks to remote object storage while brokers retain hot local data. RemoteStorageManager reads and writes remote log segments.",
      "canonicalUrl": "https://cwiki.apache.org/confluence/display/KAFKA/KIP-405%3A+Kafka+Tiered+Storage",
      "author": "Satish Duggana",
      "occurredAt": "2019-01-08T00:00:00Z",
      "sourceVersion": "confluence-kip-405-v1",
      "tags": ["storage", "tiered-storage", "broker"],
      "contentHash": "sha256:2e7534ddc79c3940b4d7862b9a3f045e0d376e54c0865f0ac7cf51970e5ddf93"
    },
