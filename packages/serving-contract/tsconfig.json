{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@oss-knowledge-base/domain": ["../domain/src/v1/index.ts"],
      "@oss-knowledge-base/search": ["../search/src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
